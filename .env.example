# Meloman environment template
#
# Copy to:
# - .env.local for root/package commands such as Drizzle
# - apps/web/.env.local for the Next.js web app
#
# Never commit real .env.local files or production secrets.

# Required: Neon PostgreSQL
# Get from Neon dashboard -> Connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required: Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional: OAuth sign-in. The Google/Facebook buttons render only when
# the matching pair below is set, so they stay hidden until real keys
# are added. Redirect/callback URL: <site>/api/auth/callback/{google,facebook}
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Optional: email verification is enforced only for accounts created
# AFTER this instant — every pre-existing account is grandfathered and
# keeps signing in unchanged (no DB backfill). Defaults to the ship
# date; set to your actual deploy time (ISO 8601) if it differs.
EMAIL_VERIFICATION_ENFORCED_FROM=

# Required for Sprint 3 live quiz real-time events.
# Get from the Pusher dashboard. Use the EU cluster unless the project changes region.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Required for audio/image upload features.
# Bucket is private; app access goes through server actions and signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: transactional email (password reset + email verification).
# Without RESEND_API_KEY the link is logged to the server console
# instead of emailed, so the flow still works in dev. RESEND_FROM
# overrides the sender address
# (defaults to "Meloman <noreply@meloman.bg>"; needs a verified domain
# to actually deliver).
RESEND_API_KEY=
RESEND_FROM=

# Optional: Spotify metadata search in admin question forms.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Vercel Cron auth for /api/cron/daily-revalidate (Mystery Artist stage
# cache-bust at 10/14/18/22 Sofia; schedules in apps/web/vercel.json are
# UTC ≈ Sofia−2). Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=
